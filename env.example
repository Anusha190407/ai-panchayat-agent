# Copy to .env for local runs (never commit the real .env).
# Free key: https://aistudio.google.com  →  Get API key
GEMINI_API_KEY=

# Optional: force a model. Leave empty to auto-pick the newest Flash-Lite / Flash your key can use.
GEMINI_MODEL=

# Optional: where the SQLite file lives (default: ./data/panchayat.db)
DB_PATH=
